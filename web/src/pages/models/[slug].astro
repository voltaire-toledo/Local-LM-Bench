---
import Base from '../../layouts/Base.astro';
import data from '../../data/results.json';

export function getStaticPaths() {
  return data.models.map((m) => ({ params: { slug: m.slug }, props: { m } }));
}

const { m } = Astro.props;
const r = m.report;
const s = m.specs ?? {};
const src = m.sources ?? {};
const q = m.quality;
const hwId = Object.keys(m.perf)[0];
const hw = data.hardware[hwId];
const p = m.perf[hwId];
const sweep = p.sweep ?? {};
const fmt = (a) => (a ? `${a[0]} of ${a[1]}` : 'not tested');
const num = (n) => (n == null ? 'unknown' : n.toLocaleString('en-US'));
const AREAS = [
  ['apps', 'Real-world applications'],
  ['agentic', 'Agentic tasks'],
  ['analysis', 'Analysis and insight surfacing'],
  ['critical', 'Critical evaluation'],
  ['workflows', 'Workflows'],
];
const EV = { measured: 'measured', inferred: 'inferred, not tested', untested: 'not tested' };
const QUANT = {
  Q4_K_M: 'A 4-bit K-quant, medium mix. Weights are stored in small blocks that each carry their own scale, and the most sensitive tensors keep a little more precision. The usual best balance of size and quality for local use.',
  Q8_0: 'Plain 8-bit with a scale per block. Close to lossless, but about 60 percent bigger than a 4-bit build, which is what pushes it out of VRAM on a 12 GB card.',
  Q4_0: 'The older, simpler 4-bit format. Builds labelled QAT were trained with 4-bit in mind, so they hold their quality better than a naive 4-bit conversion.',
  MXFP4: 'A 4-bit floating-point format with a shared exponent per small block, used natively by gpt-oss. Not a conversion of a higher-precision model.',
  IQ3_XS: 'A roughly 3-bit importance-matrix quantization. Much smaller than 4-bit, at a clear cost in precision.',
};
const kv = s.kv_kb_per_token_f16_upper_bound;
const ctxk = s.context_length_advertised ? Math.round(s.context_length_advertised / 1024) : null;
const title = m.id;
---
<Base title={title} description={r ? r.headline : `Measurements and specs for ${m.id}`} prose>
  <p class="note"><a href="/">All models</a></p>
  <h1>{m.id}</h1>
  {r && <p><span class={`v ${r.verdict}`}>{r.verdict}</span> {r.headline}</p>}

  <div class="kv">
    <div>Parameters<b>{m.params ?? 'unknown'}</b></div>
    <div>Quantization<b>{m.quant ?? 'unknown'}</b></div>
    <div>Size on disk<b>{m.size_gb ? `${m.size_gb} GB` : 'unknown'}</b></div>
    <div>Advertised context<b>{ctxk ? `${num(ctxk)}k tokens` : 'unknown'}</b></div>
    <div>Architecture<b>{s.architecture ?? 'unknown'}</b></div>
    <div>Layers (with attention)<b>{s.layers ?? '?'} ({s.attention_layers ?? '?'})</b></div>
    <div>Experts (active of total)<b>{s.experts_total ? `${s.experts_active} of ${s.experts_total}` : 'dense'}</b></div>
    <div>Sliding window<b>{s.sliding_window ? `${num(s.sliding_window)} tokens` : 'none'}</b></div>
    <div>Capabilities<b>{(s.capabilities ?? []).join(', ') || 'unknown'}</b></div>
    <div>License (first line)<b>{s.license_first_line ?? 'see source'}</b></div>
  </div>
  {kv && (
    <p class="note">
      Cache worst case: {kv} KB per token at 16-bit, assuming every attention layer remembers the whole conversation.
      {s.sliding_window && ' This model uses sliding windows, so its real cache is much smaller. '}
      <a href="/learn/kv-cache/">How the cache works</a>.
    </p>
  )}
  {s.has_system_prompt_in_modelfile && <p class="note">This build ships with its own built-in system prompt, so a "no system prompt" test is not fully blank.</p>}

  <h2>Measured results</h2>
  <p>
    Code {fmt(q.code)}. Invented items caught {fmt(q.fake_caught)}. Tool calling {fmt(q.tools)}. Benign prompts refused {fmt(q.refused)}.
    Small test sets, so one task is worth a large step. <a href="/tests/">What the tests are</a>.
  </p>
  {Object.keys(sweep).length > 0 && (
    <div class="wrap">
      <table>
        <thead><tr><th>Context</th><th>tok/s</th><th>On CPU %</th><th>VRAM peak</th><th>GPU watts</th><th>J per token</th></tr></thead>
        <tbody>
          {Object.entries(sweep).map(([c, v]) => (
            <tr><td>{Math.round(Number(c) / 1024)}k</td><td>{v.tps}</td><td>{v.cpu_pct ?? '?'}</td><td>{num(Math.round(v.vram_peak_mib))} MiB</td><td>{v.power_w}</td><td>{v.j_per_token}</td></tr>
          ))}
        </tbody>
      </table>
    </div>
  )}
  <p class="note">Hardware: {hw.label}. GPU power limit 110 W. Energy covers the GPU only.</p>

  {m.viable && (
    <>
      <h2>Viable context</h2>
      <p>
        {m.viable.viable_ctx ? <b>{Math.round(m.viable.viable_ctx / 1024)}k tokens</b> : <b>under 8k tokens</b>} passed the planted-fact test at a usable speed.
        {ctxk && <> The advertised window is {num(ctxk)}k.</>} The test stops at the first size that fails.
      </p>
      <div class="wrap">
        <table>
          <thead><tr><th>Context</th><th>Result</th><th>Codes recalled</th><th>Largest-code question</th><th>tok/s</th><th>Reply time</th><th>On CPU %</th><th>VRAM peak</th></tr></thead>
          <tbody>
            {m.viable.ladder.map((x) => (
              <tr><td>{Math.round(x.ctx / 1024)}k</td><td>{x.viable ? 'viable' : x.error ? 'failed to run' : `not viable (${x.fail_reason ?? 'see test'})`}</td><td>{x.retrieval ?? '?'} of 3</td><td>{x.reasoning == null ? '?' : x.reasoning ? 'right' : 'wrong'}</td><td>{x.tps ?? '?'}</td><td>{x.wall_s ?? '?'} s</td><td>{x.cpu_pct ?? '?'}</td><td>{x.vram_peak_mib ? `${num(Math.round(x.vram_peak_mib))} MiB` : '?'}</td></tr>
            ))}
          </tbody>
        </table>
      </div>
    </>
  )}

  {(Object.keys(m.perf).length > 1 || m.format === 'mlx') && (
    <>
      <h2>Same build on other machines</h2>
      <p>{m.format === 'mlx' ? 'MLX build: a different file from the GGUF build, so its quality scores are its own.' : 'Quality scores carry over (same file, same digest); only speed and viable context change.'}</p>
      <div class="table-wrap">
        <table>
          <thead><tr><th>Machine</th><th>Runtime</th><th>tok/s at 16k</th><th>tok/s at 64k</th><th>Viable context</th><th>First failure</th></tr></thead>
          <tbody>
            {Object.entries(m.perf).map(([id, q]: [string, any]) => {
              const v = q.viable ?? (id === hwId ? m.viable : null);
              const fail = v?.ladder?.find((x: any) => !x.viable);
              return (
                <tr><td>{data.hardware[id]?.label ?? id}</td><td>{q.runtime === 'mlx-lm' ? 'mlx-lm (MLX)' : data.hardware[id]?.runtime ?? '?'}</td><td>{q.sweep?.['16384']?.tps ?? q.tps ?? '?'}</td><td>{q.sweep?.['65536']?.tps ?? '?'}</td>
                  <td>{v ? `${Math.round(v.viable_ctx / 1024)}k` : '?'}</td><td>{fail ? `${Math.round(fail.ctx / 1024)}k: ${fail.fail_reason}` : v ? 'none up to the largest size' : '?'}</td></tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </>
  )}

  {m.suites && (
    <>
      <h2>Beyond Python: languages, documents, reasoning</h2>
      <ul>
        <li>Other languages (execution-checked): {m.suites.languages != null ? `${Math.round(m.suites.languages * 100)}%` : 'not tested'}
          {m.suites.by_language && ` (${Object.entries(m.suites.by_language).map(([k, v]) => `${k} ${v ? `${v[0]}/${v[1]}` : 'skipped'}`).join(', ')})`}</li>
        <li>Categorizing tickets: {m.suites.categorize != null ? `${Math.round(m.suites.categorize * 100)}% correct` : 'not tested'}. Executive summaries (facts kept, nothing invented): {m.suites.summaries != null ? `${Math.round(m.suites.summaries * 100)}%` : 'not tested'}.</li>
        <li>Consulting-style cases (structure and numbers, automatic proxy): {m.suites.cases != null ? `${Math.round(m.suites.cases * 100)}%` : 'not tested'}.</li>
        <li>Planted-pattern insight finding: {m.suites.insight != null ? `${Math.round(m.suites.insight * 100)}%` : 'not tested'}.</li>
      </ul>
      {m.suites.empty_answers > 0 && <p class="note">{m.suites.empty_answers} answers came back empty, which usually means the model used its output budget thinking.</p>}
    </>
  )}

  {r && (
    <>
      <h2>What we determined</h2>
      {r.preferred_over?.length > 0 && <p><span class="k">Preferred over:</span> {r.preferred_over.join('; ')}</p>}
      {r.recommended_for?.length > 0 && <p><span class="k">Recommended for:</span> {r.recommended_for.join('; ')}</p>}
      {AREAS.map(([k, label]) => r.areas?.[k] && (
        <div>
          <h3>{label}<span class="ev">{EV[r.areas[k].level]}</span></h3>
          <p>{r.areas[k].text} {r.areas[k].measured}</p>
        </div>
      ))}
      {r.caveats?.length > 0 && <p class="note">Caveats: {r.caveats.join(' ')}</p>}
    </>
  )}

  {QUANT[m.quant] && (
    <>
      <h2>What {m.quant} means</h2>
      <p>{QUANT[m.quant]} <a href="/learn/quantization/">More on quantization</a>.</p>
    </>
  )}

  <h2>Where to download it</h2>
  <p class="links">
    {src.ollama && <a href={src.ollama}>Ollama</a>}
    {src.hf_official && <a href={`https://huggingface.co/${src.hf_official}`}>Hugging Face (official)</a>}
    {(src.hf_gguf ?? []).map((g) => <a href={`https://huggingface.co/${g}`}>{g}</a>)}
  </p>
  {src.note && <p class="note">{src.note}</p>}
  {!src.hf_official && <p class="note">No Hugging Face repo found. This looks like an Ollama-only community upload, so review it before relying on it.</p>}
</Base>
