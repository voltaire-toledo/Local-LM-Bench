---
const { data } = Astro.props;
---
<div class="card">
  <div class="row">
    <div class="ctl"><label for="hw">Hardware <a class="ml" href="/hardware/" target="_blank" title="More details" aria-label="More details: hardware"></a></label><select id="hw"></select></div>
    <div class="ctl"><label for="minctx">Minimum viable context <a class="ml" href="/learn/context/" target="_blank" title="More details" aria-label="More details: what context means"></a></label>
      <select id="minctx"><option value="0">Any</option><option value="8192">8k</option><option value="16384">16k</option><option value="32768">32k</option><option value="65536">64k</option><option value="131072">128k</option></select></div>
    <div class="ctl"><label class="chk"><input type="checkbox" id="showbad" /> <span id="badlbl">Show retired models</span> <a class="ml" href="#retired" title="More details" aria-label="What retired means"></a></label></div>
  </div>
  <div class="row" style="margin-top:10px">
    <div class="ctl"><label>Accuracy (no invented facts) <a class="ml" href="/tests/#accuracy" target="_blank" title="More details"></a> <output id="o_f"></output></label><input id="w_f" type="range" min="0" max="10" value="8" /></div>
    <div class="ctl"><label>Coding: Python, Terraform <a class="ml" href="/tests/#coding" target="_blank" title="More details"></a> <output id="o_c"></output></label><input id="w_c" type="range" min="0" max="10" value="6" /></div>
    <div class="ctl"><label>Other languages <a class="ml" href="/tests/#languages" target="_blank" title="More details"></a> <output id="o_l"></output></label><input id="w_l" type="range" min="0" max="10" value="5" /></div>
    <div class="ctl"><label>Tool calling <a class="ml" href="/tests/#tools" target="_blank" title="More details"></a> <output id="o_t"></output></label><input id="w_t" type="range" min="0" max="10" value="6" /></div>
    <div class="ctl"><label>Documents <a class="ml" href="/tests/#documents" target="_blank" title="More details"></a> <output id="o_d"></output></label><input id="w_d" type="range" min="0" max="10" value="5" /></div>
    <div class="ctl"><label>Case reasoning <a class="ml" href="/tests/#cases" target="_blank" title="More details"></a> <output id="o_r"></output></label><input id="w_r" type="range" min="0" max="10" value="3" /></div>
    <div class="ctl"><label>Insight finding <a class="ml" href="/tests/#insight" target="_blank" title="More details"></a> <output id="o_i"></output></label><input id="w_i" type="range" min="0" max="10" value="3" /></div>
    <div class="ctl"><label>Speed <a class="ml" href="/learn/parameters/#speed" target="_blank" title="More details"></a> <output id="o_s"></output></label><input id="w_s" type="range" min="0" max="10" value="2" /></div>
  </div>
  <p class="note" id="hwnote" style="margin:10px 0 0"></p>
</div>
<h2>Ranking</h2>
<div class="card wrap"><table id="tbl"></table></div>
<p class="note">Click a row to add it to the side-by-side view (up to 3). The page icon opens the full model report in a new tab. A dash means not tested. An asterisk on the weighted score means the model lacks a test you weighted, so its score is partial and it sorts below fully tested models. Viable context is the largest size that passed the planted-fact test at usable speed (see <a href="/tests/">the tests</a>). Speed is generation tok/s with a 3k-token prompt at 16k context; retired models show an earlier, shorter test and are not comparable.</p>
<h2>Side by side</h2>
<div class="grid" id="cmp"></div>
<p class="note" id="retired"><b>Retired models</b> were tested, judged not worth running (too big for the memory, beaten by a sibling build, or broken), and dropped from later test runs. Their scores are kept but come from fewer tests. Tick the box to show them, greyed out.</p>
<script define:vars={{ D: data }}>
const $=s=>document.querySelector(s);const hwSel=$('#hw');let sel=[],sortKey='score',asc=false;
Object.entries(D.hardware).forEach(([k,v])=>hwSel.add(new Option(v.label,k)));
const frac=a=>a&&a[1]?a[0]/a[1]:null;const fmt=a=>a?a[0]+'/'+a[1]:'–';
const pct=v=>v==null?'–':Math.round(v*100)+'%';
const kk=c=>c==null?'–':c>=1024?Math.round(c/1024)+'k':String(c);
const avg=a=>{a=a.filter(x=>x!=null);return a.length?a.reduce((p,c)=>p+c,0)/a.length:null};
const PC='win-rtx3060-12g';const vf=(m,hw)=>(m.perf[hw]&&m.perf[hw].viable)||(hw===PC?m.viable:null);
const KEYS=['f','c','l','t','d','r','i','s'];
function rows(){const hw=hwSel.value,W={};KEYS.forEach(k=>{W[k]=+$('#w_'+k).value;$('#o_'+k).textContent=W[k]});const minc=+$('#minctx').value;
 const nb=D.models.filter(m=>m.perf[hw]&&m.report&&m.report.verdict==='non-viable').length;$('#badlbl').textContent=nb?`Show ${nb} retired model${nb>1?'s':''}`:'No retired models on this machine';$('#showbad').disabled=!nb;
 const H=D.hardware[hw],perf=D.models.map(m=>m.perf[hw]).filter(Boolean),maxT=Math.max(...perf.map(p=>p.tps||0),1);
 $('#hwnote').innerHTML=[H.os,H.runtime,H.driver].filter(Boolean).join(' | ')+' | '+(H.kind==='unified-memory'?H.memory_gb+' GB unified memory, shared with macOS and your apps. <a href="/mac/">What runs well on it</a>':H.memory_gb+' GB GPU memory');
 return D.models.filter(m=>m.perf[hw]&&($('#showbad').checked||!(m.report&&m.report.verdict==='non-viable'))&&(!minc||((vf(m,hw)||{}).viable_ctx>=minc))).map(m=>{const q=m.quality,p=m.perf[hw],s=m.suites||{},v=vf(m,hw);
  const docs=avg([s.categorize,s.summaries]);
  const parts=[['f',frac(q.fake_caught)],['c',frac(q.code)],['l',s.languages??null],['t',frac(q.tools)],['d',docs],['r',s.cases??null],['i',s.insight??null],['s',p.tps?p.tps/maxT:null]];
  let num=0,den=0;parts.forEach(([k,v])=>{if(v!==null&&W[k]>0){num+=W[k]*v;den+=W[k]}});
  const partial=parts.some(([k,v])=>W[k]>0&&v===null);
  return {m,q,p,s,partial,score:den?Math.round(100*num/den):null,fakeF:frac(q.fake_caught),codeF:frac(q.code),toolF:frac(q.tools),langF:s.languages??null,docF:docs,caseF:s.cases??null,insF:s.insight??null,tps:p.tps,gpu:p.split?p.split.gpu:null,size:m.size_gb,vctx:v?v.viable_ctx:null,v}});}
function render(){let r=rows();const k=sortKey;r.sort((a,b)=>{if(k=='score'&&a.partial!=b.partial)return a.partial?1:-1;const x=a[k],y=b[k];if(x==null)return 1;if(y==null)return -1;return asc?x-y:y-x});
 const cols=[['score','Weighted'],['vctx','Viable ctx'],['codeF','Py/TF'],['langF','Langs'],['fakeF','Fake items'],['toolF','Tools'],['docF','Docs'],['caseF','Cases'],['insF','Insight'],['tps','tok/s'],['gpu','On GPU %'],['size','GB']];
 let h='<tr><th>Model</th><th style="text-align:left">Verdict</th>'+cols.map(([c,l])=>`<th class="s${k==c&&asc?' a':''}" data-k="${c}">${l}</th>`).join('')+'</tr>';
 r.forEach(x=>{h+=`<tr data-id="${x.m.id}" class="${sel.includes(x.m.id)?'sel':''}${vd(x)==='non-viable'?' retired':''}"><td>${x.m.id} <span class="chip">${x.m.quant||''}</span></td><td style="text-align:left">${vb(x)}</td>
 <td class="${x.partial?'mut':''}" title="${x.partial?'Not tested on every area you weighted; score covers only the tests it has':''}"><span class="bar" style="width:${x.score||0}px;opacity:${x.partial?.4:1}"></span>${x.score??'–'}${x.partial?'*':''}</td>
 <td>${x.v?(x.vctx?kk(x.vctx):'&lt;8k'):'–'}</td><td>${fmt(x.q.code)}</td><td>${pct(x.langF)}</td><td>${fmt(x.q.fake_caught)}</td><td>${fmt(x.q.tools)}</td><td>${pct(x.docF)}</td><td>${pct(x.caseF)}</td><td>${pct(x.insF)}</td>
 <td>${x.tps??'–'}</td><td class="${x.gpu!=null&&x.gpu<100?'bad':''}">${x.gpu??'–'}</td><td>${x.size??'–'}</td></tr>`});
 $('#tbl').innerHTML=h;$('#tbl').querySelectorAll('th.s').forEach(t=>t.onclick=()=>{const c=t.dataset.k;asc=sortKey==c?!asc:false;sortKey=c;render()});
 $('#tbl').querySelectorAll('tr[data-id]').forEach(t=>t.onclick=()=>{if(String(getSelection()))return;const id=t.dataset.id;sel=sel.includes(id)?sel.filter(s=>s!=id):[...sel.slice(-2),id];render()});
 $('#tbl').querySelectorAll('a.repicon').forEach(b=>b.onclick=e=>e.stopPropagation());
 const by=Object.fromEntries(r.map(x=>[x.m.id,x]));
 $('#cmp').innerHTML=sel.length?sel.map(id=>{const x=by[id];if(!x)return'';const b=(l,v,t)=>`<div class="m"><span>${l}</span><span>${t}</span></div><div class="t"><i style="width:${Math.round((v||0)*100)}%"></i></div>`;
  return `<div class="card"><h3 style="margin:0 0 8px">${id}</h3>${b('Python and Terraform',x.codeF,fmt(x.q.code))}${b('Other languages',x.langF,pct(x.langF))}${b('Fake items caught',x.fakeF,fmt(x.q.fake_caught))}${b('Tool calling',x.toolF,fmt(x.q.tools))}${b('Documents',x.docF,pct(x.docF))}${b('Case reasoning',x.caseF,pct(x.caseF))}${b('Insight finding',x.insF,pct(x.insF))}${b('Viable context',x.vctx?x.vctx/131072:0,x.v?(x.vctx?kk(x.vctx):'<8k'):'–')}${b('Speed',x.tps/Math.max(...r.map(y=>y.tps||0),1),(x.tps??'–')+' tok/s')}<div class="m"><span>${x.m.params||''} ${x.m.quant||''}</span><span>${x.size??'–'} GB, ${x.gpu??'?'}% on GPU</span></div></div>`}).join(''):'<p class="note">Select up to three models in the table.</p>';
 }
const vd=x=>(x.m.report&&x.m.report.verdict)||'untriaged';
const ICON='<svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M7 3h7l5 5v13H7z" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 3v5h5M10 12h6M10 15.5h6M10 19h4" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>';
const vb=x=>`<a class="repicon" href="/models/${x.m.slug}/" target="_blank" title="Open the full report in a new tab" aria-label="Report for ${x.m.id}">${ICON}</a><span class="v ${vd(x)}">${vd(x)}</span>`;
document.querySelectorAll('input[type=range],select,#showbad').forEach(e=>e.oninput=render);render();
</script>
